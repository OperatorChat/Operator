<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary text in a focusable row: muted when idle, the focus text colour when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="?attr/opFocusText" />
    <item android:state_pressed="true" android:color="?attr/opFocusText" />
    <item android:color="?attr/opTextSecondary" />
</selector>
