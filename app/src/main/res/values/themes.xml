<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base: everything the UI needs, defaulting to Switchboard. -->
    <style name="Theme.Operator" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="opBackground">@color/switchboard_background</item>
        <item name="opSurface">@color/switchboard_surface</item>
        <item name="opText">@color/switchboard_text</item>
        <item name="opTextSecondary">@color/switchboard_text_secondary</item>
        <item name="opFocus">@color/switchboard_focus</item>
        <item name="opFocusText">@color/switchboard_focus_text</item>
        <item name="opFocusRing">@color/switchboard_focus_ring</item>
        <item name="opFocusTint">@color/focus_tint</item>
        <item name="opFocusRingMine">@color/focus_ring_mine</item>
        <item name="opFocusTintMine">@color/focus_tint_mine</item>
        <item name="opFocusBand">@color/focus_band</item>
        <item name="opHairline">@color/switchboard_hairline</item>
        <!-- Outlines are a High contrast feature; the other themes draw none. -->
        <item name="opOutline">@android:color/transparent</item>
        <item name="opAccent">@color/switchboard_accent</item>
        <item name="opBubbleTheirs">@color/switchboard_bubble_theirs</item>
        <item name="opBubbleMineSending">@color/switchboard_bubble_sending</item>
        <item name="opBubbleMineSent">@color/switchboard_bubble_sent</item>
        <item name="opBubbleMineRead">@color/switchboard_bubble_read</item>
        <item name="opBubbleMineFailed">@color/switchboard_bubble_failed</item>
        <item name="opBubbleMineText">@color/switchboard_bubble_mine_text</item>
        <item name="opSoftkeyBackground">@color/switchboard_softkey_background</item>
        <item name="opSoftkeyText">@color/switchboard_softkey_text</item>
        <item name="opOutlineWidth">1dp</item>
        <item name="opTextTitle">@dimen/text_title</item>
        <item name="opTextBody">@dimen/text_body</item>
        <item name="opTextSmall">@dimen/text_small</item>

        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:windowBackground">?attr/opBackground</item>
        <item name="android:textColorPrimary">?attr/opText</item>
        <item name="android:textColorSecondary">?attr/opTextSecondary</item>
        <item name="colorAccent">?attr/opFocus</item>
        <!-- The status bar and navigation bar take the paper colour (set at runtime with matching icon tint). -->
        <item name="android:statusBarColor">?attr/opBackground</item>
        <item name="android:navigationBarColor">?attr/opBackground</item>
        <!-- Screen changes are animated by the host; no window animations (SPEC §7). -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.Operator.Switchboard" />

    <!-- The brand theme, default for new installs. -->
    <style name="Theme.Operator.Brand">
        <item name="opBackground">@color/operator_background</item>
        <item name="opSurface">@color/operator_surface</item>
        <item name="opText">@color/operator_text</item>
        <item name="opTextSecondary">@color/operator_text_secondary</item>
        <item name="opFocus">@color/operator_focus</item>
        <item name="opFocusText">@color/operator_focus_text</item>
        <item name="opFocusRing">@color/operator_focus_ring</item>
        <item name="opFocusBand">@color/operator_focus_band</item>
        <item name="opHairline">@color/operator_hairline</item>
        <item name="opAccent">@color/operator_accent</item>
        <item name="opBubbleTheirs">@color/operator_bubble_theirs</item>
        <item name="opBubbleMineSending">@color/operator_bubble_sending</item>
        <item name="opBubbleMineSent">@color/operator_bubble_sent</item>
        <item name="opBubbleMineRead">@color/operator_bubble_read</item>
        <item name="opBubbleMineFailed">@color/operator_bubble_failed</item>
        <item name="opBubbleMineText">@color/operator_bubble_mine_text</item>
        <item name="opSoftkeyBackground">@color/operator_softkey_background</item>
        <item name="opSoftkeyText">@color/operator_softkey_text</item>
    </style>

    <style name="Theme.Operator.Matrix">
        <item name="opBackground">@color/matrix_background</item>
        <item name="opSurface">@color/matrix_surface</item>
        <item name="opText">@color/matrix_text</item>
        <item name="opTextSecondary">@color/matrix_text_secondary</item>
        <item name="opFocus">@color/matrix_focus</item>
        <item name="opFocusText">@color/matrix_focus_text</item>
        <item name="opFocusRing">@color/matrix_focus_ring</item>
        <item name="opHairline">@color/matrix_hairline</item>
        <item name="opAccent">@color/matrix_accent</item>
        <item name="opBubbleTheirs">@color/matrix_bubble_theirs</item>
        <item name="opBubbleMineSending">@color/matrix_bubble_sending</item>
        <item name="opBubbleMineSent">@color/matrix_bubble_sent</item>
        <item name="opBubbleMineRead">@color/matrix_bubble_read</item>
        <item name="opBubbleMineFailed">@color/matrix_bubble_failed</item>
        <item name="opBubbleMineText">@color/matrix_bubble_mine_text</item>
        <item name="opSoftkeyBackground">@color/matrix_softkey_background</item>
        <item name="opSoftkeyText">@color/matrix_softkey_text</item>
    </style>

    <style name="Theme.Operator.HighContrast">
        <item name="opBackground">@color/hc_background</item>
        <item name="opSurface">@color/hc_surface</item>
        <item name="opText">@color/hc_text</item>
        <item name="opTextSecondary">@color/hc_text_secondary</item>
        <item name="opFocus">@color/hc_focus</item>
        <item name="opFocusText">@color/hc_focus_text</item>
        <item name="opFocusRing">@color/hc_text</item>
        <item name="opFocusTint">@android:color/transparent</item>
        <item name="opFocusRingMine">@color/hc_text</item>
        <item name="opFocusTintMine">@android:color/transparent</item>
        <item name="opFocusBand">@android:color/transparent</item>
        <item name="opHairline">@color/hc_hairline</item>
        <item name="opOutline">@color/hc_outline</item>
        <item name="opAccent">@color/hc_accent</item>
        <item name="opBubbleTheirs">@color/hc_bubble_theirs</item>
        <item name="opBubbleMineSending">@color/hc_bubble_sending</item>
        <item name="opBubbleMineSent">@color/hc_bubble_sent</item>
        <item name="opBubbleMineRead">@color/hc_bubble_read</item>
        <item name="opBubbleMineFailed">@color/hc_bubble_failed</item>
        <item name="opBubbleMineText">@color/hc_bubble_mine_text</item>
        <item name="opSoftkeyBackground">@color/hc_softkey_background</item>
        <item name="opSoftkeyText">@color/hc_softkey_text</item>
        <item name="opOutlineWidth">2dp</item>
    </style>

    <style name="Theme.Operator.Slate">
        <item name="opBackground">@color/slate_background</item>
        <item name="opSurface">@color/slate_surface</item>
        <item name="opText">@color/slate_text</item>
        <item name="opTextSecondary">@color/slate_text_secondary</item>
        <item name="opFocus">@color/slate_focus</item>
        <item name="opFocusText">@color/slate_focus_text</item>
        <item name="opFocusRing">@color/slate_focus_ring</item>
        <item name="opHairline">@color/slate_hairline</item>
        <item name="opAccent">@color/slate_accent</item>
        <item name="opBubbleTheirs">@color/slate_bubble_theirs</item>
        <item name="opBubbleMineSending">@color/slate_bubble_sending</item>
        <item name="opBubbleMineSent">@color/slate_bubble_sent</item>
        <item name="opBubbleMineRead">@color/slate_bubble_read</item>
        <item name="opBubbleMineFailed">@color/slate_bubble_failed</item>
        <item name="opBubbleMineText">@color/slate_bubble_mine_text</item>
        <item name="opSoftkeyBackground">@color/slate_softkey_background</item>
        <item name="opSoftkeyText">@color/slate_softkey_text</item>
    </style>

    <!-- Text size overlays, applied on top of the theme. -->
    <style name="TextScale.Normal" parent="">
        <item name="opTextTitle">@dimen/text_title</item>
        <item name="opTextBody">@dimen/text_body</item>
        <item name="opTextSmall">@dimen/text_small</item>
    </style>
    <style name="TextScale.Large" parent="">
        <item name="opTextTitle">@dimen/text_title_large</item>
        <item name="opTextBody">@dimen/text_body_large</item>
        <item name="opTextSmall">@dimen/text_small_large</item>
    </style>
    <style name="TextScale.ExtraLarge" parent="">
        <item name="opTextTitle">@dimen/text_title_xl</item>
        <item name="opTextBody">@dimen/text_body_xl</item>
        <item name="opTextSmall">@dimen/text_small_xl</item>
    </style>

    <!-- Widget styles. -->
    <style name="Text.Operator" parent="android:Widget.TextView">
        <item name="android:textColor">?attr/opText</item>
        <item name="android:textSize">?attr/opTextBody</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="Text.Operator.Title">
        <item name="android:textSize">?attr/opTextTitle</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Operator.Body" />

    <!-- Semibold body text: names, labels. -->
    <style name="Text.Operator.Strong">
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>

    <style name="Text.Operator.Small">
        <item name="android:textSize">?attr/opTextSmall</item>
        <item name="android:textColor">?attr/opTextSecondary</item>
    </style>

    <!-- A focusable text link: a pill that fills with the focus colour. -->
    <style name="Text.Operator.Link">
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">@drawable/pill_background</item>
        <item name="android:padding">@dimen/gap</item>
        <item name="android:textColor">@color/focusable_accent_text</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>

    <style name="Text.Operator.SoftKey">
        <item name="android:textSize">?attr/opTextBody</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">?attr/opSoftkeyText</item>
        <item name="android:background">@drawable/softkey_chip</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxWidth">150dp</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Screen header: title at the top of a screen, optional detail on the right. -->
    <style name="Text.Operator.Header">
        <item name="android:textSize">?attr/opTextTitle</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Button.Operator" parent="android:Widget.Button">
        <!-- The phone reports a touch panel, so windows start in touch mode and
             plain focus is hidden; keypad users need focus visible from the start. -->
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:background">@drawable/pill_background</item>
        <item name="android:textColor">@color/focusable_text</item>
        <item name="android:textSize">?attr/opTextBody</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/row_min_height</item>
        <item name="android:paddingLeft">@dimen/gap_large</item>
        <item name="android:paddingRight">@dimen/gap_large</item>
        <item name="android:paddingTop">@dimen/gap</item>
        <item name="android:paddingBottom">@dimen/gap</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Fields keep their own colour and show focus as an accent ring, so typed text stays readable. -->
    <style name="EditText.Operator" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/field_background</item>
        <item name="android:textColor">?attr/opText</item>
        <item name="android:textColorHint">?attr/opTextSecondary</item>
        <item name="android:textSize">?attr/opTextBody</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">@dimen/gap</item>
        <item name="android:paddingBottom">@dimen/gap</item>
        <item name="android:minHeight">@dimen/row_min_height</item>
    </style>
</resources>
