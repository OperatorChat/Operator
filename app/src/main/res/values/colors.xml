<?xml version="1.0" encoding="utf-8"?>
<!-- Light variants of the four themes. Dark variants live in values-night.
     My bubbles are solid colours that say how the message is doing: muted while
     sending, the accent once sent, a green once read, red if it failed. -->
<resources>
    <!-- Operator: the brand. Beige paper, navy ink and focus; a warm tan for surfaces and the
         focus band so highlights belong to the palette. Orange (darkened for text) only as accent. -->
    <color name="operator_background">#FBF4E6</color>
    <color name="operator_surface">#F0E4CC</color>
    <color name="operator_text">#17243C</color>
    <color name="operator_text_secondary">#5B6478</color>
    <color name="operator_focus">#17243C</color>
    <color name="operator_focus_text">#FBF4E6</color>
    <color name="operator_focus_ring">#B317243C</color>
    <color name="operator_focus_band">#E7D9B8</color>
    <color name="operator_hairline">#E2D5B6</color>
    <color name="operator_outline">#8A8F9C</color>
    <color name="operator_accent">#D96400</color>
    <color name="operator_bubble_theirs">#F0E4CC</color>
    <color name="operator_bubble_sending">#8E97AA</color>
    <color name="operator_bubble_sent">#17243C</color>
    <color name="operator_bubble_read">#2F6F5E</color>
    <color name="operator_bubble_failed">#A23B3B</color>
    <color name="operator_bubble_mine_text">#FBF4E6</color>
    <color name="operator_softkey_background">#FBF4E6</color>
    <color name="operator_softkey_text">#17243C</color>

    <!-- Switchboard: warm neutrals with the brand's amber highlight. -->
    <color name="switchboard_background">#FFFFFF</color>
    <color name="switchboard_surface">#F2F2F2</color>
    <color name="switchboard_text">#000000</color>
    <color name="switchboard_text_secondary">#5C5C5C</color>
    <color name="switchboard_focus">@color/brand_accent</color>
    <color name="switchboard_focus_text">#000000</color>
    <color name="switchboard_hairline">#E4E4E4</color>
    <color name="switchboard_outline">#6B6B6B</color>
    <color name="switchboard_accent">@color/brand_accent</color>
    <color name="switchboard_bubble_theirs">#F2F2F2</color>
    <color name="switchboard_bubble_sending">#E6E0CC</color>
    <color name="switchboard_bubble_sent">#FFC845</color>
    <color name="switchboard_bubble_read">#9CCC65</color>
    <color name="switchboard_bubble_failed">#EF9A9A</color>
    <color name="switchboard_bubble_mine_text">#000000</color>
    <color name="switchboard_softkey_background">#FFFFFF</color>
    <color name="switchboard_softkey_text">#8A5A00</color>

    <!-- Matrix: pale phosphor greens on near-white; the dark variant is the real thing. -->
    <color name="matrix_background">#F3FBF3</color>
    <color name="matrix_surface">#E1F3E1</color>
    <color name="matrix_text">#062B0E</color>
    <color name="matrix_text_secondary">#2F5E36</color>
    <color name="matrix_focus">#0B8F3A</color>
    <color name="matrix_focus_text">#FFFFFF</color>
    <color name="matrix_hairline">#CFE6CF</color>
    <color name="matrix_outline">#2E7D32</color>
    <color name="matrix_accent">#0B8F3A</color>
    <color name="matrix_bubble_theirs">#E1F3E1</color>
    <color name="matrix_bubble_sending">#9DBBA0</color>
