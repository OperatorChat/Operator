<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/title"
            style="@style/Text.Operator.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/other_server_title" />

        <TextView
            android:id="@+id/explanation"
            style="@style/Text.Operator.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:visibility="gone" />

        <EditText
            android:id="@+id/server"
            style="@style/EditText.Operator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:hint="@string/other_server_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/user"
            style="@style/EditText.Operator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:hint="@string/other_server_user_hint"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:singleLine="true" />

        <EditText
            android:id="@+id/password"
            style="@style/EditText.Operator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:hint="@string/other_server_password_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView
            android:id="@+id/status"
            style="@style/Text.Operator.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:visibility="gone" />

        <Button
            android:id="@+id/button"
            style="@style/Button.Operator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:text="@string/other_server_button" />
    </LinearLayout>
</ScrollView>
