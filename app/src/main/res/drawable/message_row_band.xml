<?xml version="1.0" encoding="utf-8"?>
<!-- Behind a focused message row: a soft band across the width, so the selection reads at a glance. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="@integer/focus_fade_ms">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/opFocusBand" />
            <corners android:radius="@dimen/row_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
