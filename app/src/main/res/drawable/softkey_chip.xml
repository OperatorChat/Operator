<?xml version="1.0" encoding="utf-8"?>
<!-- A soft-key label chip: a pill in the surface colour, echoing the physical key below it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/opSurface" />
    <stroke android:width="?attr/opOutlineWidth" android:color="?attr/opOutline" />
    <corners android:radius="@dimen/pill_radius" />
</shape>
