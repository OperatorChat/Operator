<?xml version="1.0" encoding="utf-8"?>
<!-- Text fields: a rounded surface; focus is a 2dp accent ring, so the text keeps its colour. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/opSurface" />
            <stroke android:width="2dp" android:color="?attr/opFocus" />
            <corners android:radius="@dimen/pill_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/opSurface" />
            <stroke android:width="?attr/opOutlineWidth" android:color="?attr/opOutline" />
            <corners android:radius="@dimen/pill_radius" />
        </shape>
    </item>
</selector>
