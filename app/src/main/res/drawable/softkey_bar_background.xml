<?xml version="1.0" encoding="utf-8"?>
<!-- The soft-key strip: paper colour with a hairline along the top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/opHairline" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/opSoftkeyBackground" />
        </shape>
    </item>
</layer-list>
