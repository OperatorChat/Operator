<?xml version="1.0" encoding="utf-8"?>
<!-- Unread count: an accent pill; inverted when the row is focused (duplicateParentState). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/opFocusText" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/opAccent" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
