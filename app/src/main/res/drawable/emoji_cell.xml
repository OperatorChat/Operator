<?xml version="1.0" encoding="utf-8"?>
<!-- One reaction in the emoji grid: filled when focused, ringed when it is a reaction you have already sent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="@integer/focus_fade_ms">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/opFocus" />
            <stroke android:width="?attr/opOutlineWidth" android:color="?attr/opOutline" />
            <corners android:radius="@dimen/row_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/opFocus" />
            <corners android:radius="@dimen/row_radius" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/opSurface" />
            <stroke android:width="2dp" android:color="?attr/opAccent" />
            <corners android:radius="@dimen/row_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="?attr/opOutlineWidth" android:color="?attr/opOutline" />
            <corners android:radius="@dimen/row_radius" />
        </shape>
    </item>
</selector>
