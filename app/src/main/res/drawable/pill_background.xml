<?xml version="1.0" encoding="utf-8"?>
<!-- Buttons and links: a surface-coloured pill that fills with the focus colour. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="@integer/focus_fade_ms">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/opFocus" />
            <stroke android:width="?attr/opOutlineWidth" android:color="?attr/opOutline" />
            <corners android:radius="@dimen/pill_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/opFocus" />
            <corners android:radius="@dimen/pill_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/opSurface" />
            <stroke android:width="?attr/opOutlineWidth" android:color="?attr/opOutline" />
            <corners android:radius="@dimen/pill_radius" />
        </shape>
    </item>
</selector>
